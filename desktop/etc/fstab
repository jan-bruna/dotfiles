# Static information about the filesystems.
# See fstab(5) for details.

# <file system> <dir> <type> <options> <dump> <pass>
# /dev/nvme0n1p2
UUID=	/         	ext4      	rw,noatime	0 1

# /dev/nvme0n1p1
UUID=      	/boot     	vfat      	rw,noatime,fmask=0077,dmask=0077,codepage=437,iocharset=ascii,shortname=mixed,utf8,errors=remount-ro,nodev,nosuid	0 2

#bind mounts experiment, noatime, nosuid, nodev
/home	/home	none	bind,nosuid,nodev	0 0
/var	/var	none	bind,nosuid		0 0
